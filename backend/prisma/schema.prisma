generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id
  email       String       @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  createdAt   DateTime     @default(now())

  bookmarks   Bookmark[]
  gameResults GameResult[]
  pushTokens  PushToken[]
  sessions    Session[]
}

model Session {
  id        String   @id
  userId    String
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id           String   @id
  userId       String
  type         String   // article, game, post
  title        String
  url          String
  thumbnailUrl String?
  metadata     String?  // Stored as JSON string
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GameResult {
  id             String   @id
  challengeId    String
  userId         String?  // Nullable for anonymous play
  score          Int
  maxScore       Int?
  durationMs     Int
  rank           Int?
  streak         Int?
  isPersonalBest Boolean?
  answers        String?  // Stored as JSON string array
  createdAt      DateTime @default(now())

  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushToken {
  id          String   @id
  userId      String
  token       String   @unique
  platform    String
  deviceName  String?
  preferences String?  // Stored as JSON string
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
